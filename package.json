{
  "name": "ai-vocabulary-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI-powered contextual English vocabulary learning platform.",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "boundaries": "node scripts/check-boundaries.mjs",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo coverage",
    "ci:all": "pnpm ci:security && pnpm ci:quality",
    "ci:quality": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:accessibility && pnpm build",
    "ci:security": "node scripts/ci-policy.mjs",
    "contract:check": "pnpm --filter @vocabulary/api-contract contract:check",
    "contract:generate": "pnpm --filter @vocabulary/api-contract contract:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && pnpm boundaries && pnpm contract:check && pnpm format:check",
    "prepare": "husky",
    "test": "vitest run --passWithNoTests",
    "test:accessibility": "vitest run packages/ui apps/web apps/admin --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,css,scss}": "prettier --write"
  }
}
