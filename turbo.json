{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", ".env.local", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "ADMIN_APP_ENV",
    "ADMIN_API_URL",
    "NEXT_PUBLIC_APP_ENV",
    "NEXT_PUBLIC_API_URL",
    "EXPO_PUBLIC_APP_ENV",
    "EXPO_PUBLIC_API_URL",
    "EXPO_NO_TELEMETRY",
    "__UNSAFE_EXPO_HOME_DIRECTORY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
